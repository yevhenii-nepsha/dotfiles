#!/bin/bash

source "$CONFIG_DIR/colors.sh"
PLUGIN_DIR="$CONFIG_DIR/plugins"
FONT="JetBrainsMono Nerd Font"

##### Bar #####

sketchybar --bar position=bottom \
                 height=36 \
                 color="$BAR_COLOR" \
                 border_color="$GREY_DARK" \
                 border_width=1 \
                 margin=8 \
                 y_offset=6 \
                 corner_radius=10 \
                 padding_left=8 \
                 padding_right=8 \
                 topmost=off

sketchybar --default icon.font="$FONT:Bold:15.0" \
                     icon.color="$WHITE" \
                     label.font="$FONT:Medium:13.0" \
                     label.color="$FG" \
                     padding_left=3 \
                     padding_right=3 \
                     icon.padding_left=8 \
                     icon.padding_right=8 \
                     label.padding_right=8 \
                     background.height=24 \
                     background.corner_radius=6

##### Spaces (left) #####

SPACE_COUNT=$("$PLUGIN_DIR/space_count.sh")

for i in $(seq 1 "$SPACE_COUNT"); do
  sketchybar --add space space.$i left \
             --set space.$i space=$i \
                            icon=$i \
                            label.drawing=off \
                            background.color="$ITEM_BG" \
                            script="$PLUGIN_DIR/space.sh" \
           --subscribe space.$i mouse.clicked
done

sketchybar --add item space_watcher left \
           --set space_watcher drawing=off \
                               script="$PLUGIN_DIR/space_watcher.sh" \
           --subscribe space_watcher space_change display_change

##### Spotify (center) #####

sketchybar --add event spotify_change "com.spotify.client.PlaybackStateChanged" \
           --add item spotify center \
           --set spotify drawing=off \
                         background.color="$ITEM_BG" \
                         script="$PLUGIN_DIR/spotify.sh" \
           --subscribe spotify spotify_change mouse.clicked

##### Clock (right) #####

sketchybar --add item clock right \
           --set clock update_freq=10 \
                       icon="󰃭" \
                       icon.color="$BLUE" \
                       background.color="$ITEM_BG" \
                       script="$PLUGIN_DIR/clock.sh" \
                       click_script="open -a Calendar" \
           --subscribe clock system_woke

##### Volume (right, next to clock) #####

sketchybar --add slider volume right \
           --set volume slider.width=0 \
                        slider.highlight_color="$BLUE" \
                        slider.background.height=5 \
                        slider.background.corner_radius=3 \
                        slider.background.color="$GREY_DARK" \
                        slider.knob="●" \
                        slider.knob.color="$BLUE" \
                        slider.knob.drawing=on \
                        icon.color="$BLUE" \
                        label.drawing=off \
                        label.width=40 \
                        background.color="$ITEM_BG" \
                        script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change mouse.scrolled mouse.clicked \
                              mouse.entered mouse.exited

sketchybar --update
